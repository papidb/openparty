<Layouts.flash_group flash={@flash} />
<main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
  <section class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
    <div class="mb-5">
      <h1 class="text-2xl font-semibold tracking-tight text-zinc-900">OpenParty Demo Video</h1>
      <p class="mt-2 text-sm text-zinc-600">
        Use this page to test extension video detection and host play/pause behavior.
      </p>
    </div>

    <div class="overflow-hidden rounded-xl border border-zinc-200 bg-zinc-950">
      <video
        id="openparty-demo-video"
        controls
        preload="metadata"
        class="aspect-video w-full"
        poster="https://images.unsplash.com/photo-1506157786151-b8491531f063?auto=format&fit=crop&w=1600&q=80"
      >
        <source
          src="https://storage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
          type="video/mp4"
        /> Your browser does not support the HTML video element.
      </video>
    </div>

    <div class="mt-4 rounded-lg bg-zinc-50 p-3 text-xs text-zinc-600">
      Tip: open the extension popup on this page and verify the status changes to "Video detected".
    </div>
  </section>
</main>
